rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }\n    function superAdmin() { return signedIn() && request.auth.token.email == "shadydawoud577@gmail.com"; }
    match /teamPosts/{groupId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }
    match /customEvents/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn();
      allow delete: if signedIn();
    }
    match /leaders/{teamId}/{fileName} {
      allow read: if signedIn();
      allow write, delete: if superAdmin();
    }
    match /meetingAttachments/{type}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn();
      allow delete: if signedIn();
    }
  }
}

