rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /teamPosts/{groupId}/{userId}/{fileName} {
      // الصور المنشورة في مجموعة الخدمة العامة
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
