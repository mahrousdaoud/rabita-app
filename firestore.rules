rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.isAdmin == true;
    }

    // بيانات الطالب
    match /students/{studentId} {
      allow read: if request.auth != null;
      // الطالب بيسجل بياناته هو بنفسه أول مرة بس
      allow create: if request.auth != null && request.auth.uid == studentId;
      // تعديل البيانات (زي تحديث العشور) للأدمن بس، أو الطالب نفسه لو عايز يعدل بياناته الشخصية
      allow update: if request.auth != null &&
        (request.auth.uid == studentId || isAdmin());
    }

    // اللقاءات: أي حد مسجل يقرأ، الأدمن بس يضيف/يعدل/يمسح
    match /meetings/{meetingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // سجلات الحضور: أي حد يقرأ سجلاته، الأدمن بس يسجل الحضور
    match /attendanceRecords/{recordId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
