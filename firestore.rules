rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function profileExists(){ return signedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid)); }
    function myProfile(){ return get(/databases/$(database)/documents/students/$(request.auth.uid)).data; }
    function isSuperAdmin(){ return signedIn() && (request.auth.token.email == 'shadydawoud577@gmail.com' || (profileExists() && myProfile().isAdmin == true)); }
    function isExcuseAdmin(){ return signedIn() && (isSuperAdmin() || (exists(/databases/$(database)/documents/appSettings/general) && request.auth.uid in get(/databases/$(database)/documents/appSettings/general).data.excuseAdminIds)); }
    function isTeamAdminOf(teamId){ return signedIn() && teamId != null && exists(/databases/$(database)/documents/teams/$(teamId)) && ((get(/databases/$(database)/documents/teams/$(teamId)).data.adminIds != null && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.adminIds) || (profileExists() && myProfile().adminTeamIds != null && request.auth.uid in myProfile().adminTeamIds) || (profileExists() && myProfile().adminTeamId != null && myProfile().adminTeamId == teamId)); }
    function isSchoolAdminOf(schoolId){ return signedIn() && schoolId != null && exists(/databases/$(database)/documents/schools/$(schoolId)) && ((get(/databases/$(database)/documents/schools/$(schoolId)).data.adminIds != null && request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)).data.adminIds) || (profileExists() && myProfile().adminSchoolIds != null && request.auth.uid in myProfile().adminSchoolIds)); }

    match /students/{studentId} {
      allow read: if signedIn() && (request.auth.uid == studentId || isSuperAdmin() || isTeamAdminOf(resource.data.teamId) || isSchoolAdminOf(resource.data.schoolId));
      allow create: if signedIn() && request.auth.uid == studentId;
      allow update: if isSuperAdmin() || (signedIn() && request.auth.uid == studentId && request.resource.data.email == resource.data.email && request.resource.data.isAdmin == resource.data.isAdmin);
      allow delete: if isSuperAdmin() || isTeamAdminOf(resource.data.teamId) || isSchoolAdminOf(resource.data.schoolId);
    }

    match /publicBirthdays/{uid} { allow read: if signedIn(); allow create, update: if signedIn() && (request.auth.uid == uid || isSuperAdmin()); allow delete: if isSuperAdmin() || request.auth.uid == uid; }
    match /blacklist/{uid} { allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid); allow create, update, delete: if isSuperAdmin(); }
    match /appSettings/{docId} { allow read: if signedIn(); allow create, update: if isSuperAdmin(); }

    match /teams/{teamId} { allow read: if signedIn(); allow create,update,delete: if isSuperAdmin(); }
    match /schools/{schoolId} { allow read: if signedIn(); allow create,update,delete: if isSuperAdmin(); }

    match /customEvents/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin() || (request.resource.data.teamId != null && isTeamAdminOf(request.resource.data.teamId)) || (request.resource.data.schoolId != null && isSchoolAdminOf(request.resource.data.schoolId));
      allow update,delete: if isSuperAdmin() || (resource.data.teamId != null && isTeamAdminOf(resource.data.teamId)) || (resource.data.schoolId != null && isSchoolAdminOf(resource.data.schoolId));
    }

    // Member "فوت" / expected attendance. A member can always create/update their own record.
    match /availability/{recordId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.studentId || isSuperAdmin() || isTeamAdminOf(resource.data.teamId) || isSchoolAdminOf(resource.data.schoolId));
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow delete: if isSuperAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
    }

    match /attendanceRecords/{recordId} {
      allow read: if signedIn() && (isSuperAdmin() || request.auth.uid == resource.data.studentId || isTeamAdminOf(resource.data.teamId) || isSchoolAdminOf(resource.data.schoolId));
      allow create,update: if isSuperAdmin() || isTeamAdminOf(request.resource.data.teamId) || isSchoolAdminOf(request.resource.data.schoolId);
      allow delete: if isSuperAdmin();
    }

    match /teamPosts/{postId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.authorId == request.auth.uid; allow update,delete: if signedIn() && (request.auth.uid == resource.data.authorId || isSuperAdmin()); }
    match /teamPostComments/{commentId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.authorId == request.auth.uid; allow update,delete: if signedIn() && (request.auth.uid == resource.data.authorId || isSuperAdmin()); }

    match /excuses/{excuseId} {
      allow read: if signedIn() && (isExcuseAdmin() || request.auth.uid == resource.data.studentId || isTeamAdminOf(resource.data.teamId) || isSchoolAdminOf(resource.data.schoolId));
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid && profileExists();
      allow update: if isExcuseAdmin() || (signedIn() && request.auth.uid == resource.data.studentId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason','updatedAt'])) || ((isTeamAdminOf(resource.data.teamId) || isSchoolAdminOf(resource.data.schoolId)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminReply','rejectedByName','rejectedByPhone','updatedAt']));
      allow delete: if isSuperAdmin() || isExcuseAdmin() || (signedIn() && resource.data.studentId == request.auth.uid) || isTeamAdminOf(resource.data.teamId) || isSchoolAdminOf(resource.data.schoolId);
    }
  }
}
